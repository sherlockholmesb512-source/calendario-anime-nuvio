# Porta di ascolto. Su Railway la imposta Railway stessa: non toccarla.
PORT=7000

# Ogni quanti minuti viene riscaricato AnimeWorld (default 5).
REFRESH_MS=300000

# Timeout delle richieste verso AnimeWorld e pausa minima fra due richieste
# (per non farsi bloccare dal rate limit del sito).
HTTP_TIMEOUT_MS=20000
MIN_REQUEST_GAP_MS=120

# Nel catalogo "Calendario Anime" si mostrano SOLO le uscite di oggi con orario
# certo. Impostandola a true, in coda verrebbero aggiunti anche gli episodi che
# AnimeWorld elenca come "uscite indeterminate" (senza giorno/orario): sono
# della settimana intera, non di oggi, quindi di norma non serve.
INCLUDE_INDETERMINATE=false

# Arricchimento dei metadati dall'addon di terze parti Kitsu
# (https://anime-kitsu.strem.fun/manifest.json): descrizioni, voto IMDb, generi
# e art (background/logo). Il match usa gli id MAL/AniList che AnimeWorld espone.
# Se l'addon non risponde si continuano a usare i dati AnimeWorld.
KITSU_ENABLED=true
KITSU_BASE=https://anime-kitsu.strem.fun
KITSU_TIMEOUT_MS=20000
KITSU_CACHE_MS=86400000

# API kitso.io usata come fallback per le miniature episodio quando l'addon
# Kitsu non le fornisce. Lascia vuoto per disattivarla.
KITSU_API_BASE=https://kitsu.io/api/edge

# TMDB API key (opzionale): fonti affidabili per le miniature degli episodi
# (still ufficiali per episodio) quando l'addon e kitso.io non coprono il titolo;
# da Render e' raggiungibile a differenza di kitso.io. Vuoto = disattivato.
# Se lasciata vuota viene usata la chiave predefinita dell'addon.
TMDB_API_KEY=

# TheTVDB v4 (opzionale): riserva per la STRUTTURA DELLE STAGIONI quando
# AIOMetadata e TMDB non danno risultati. Vuoto = chiave predefinita dell'addon.
TVDB_API_KEY=

# --- Stagioni multiple + dettagli episodio ---------------------------------
# AIOMetadata (addon di terze parti basato su TVDB/TMDB/MAL): fonte migliore per
# gli anime perche' conosce le STAGIONI REALI (su TMDB molte stagioni anime sono
# fuse in una sola) e fornisce titolo, trama italiana, miniatura e data di
# uscita di ogni episodio. AIO_BASE='' per disattivarlo.
AIO_BASE=https://aiometadata.fortheweak.cloud/stremio/b297adf1-6269-4ac4-9b59-813deef624bd
AIO_ENABLED=true
AIO_TIMEOUT_MS=15000

# Raggruppamento delle stagioni AnimeWorld: quando una serie ha piu' pagine
# (sequel/prequel/cour) la scheda le unisce tutte in un solo elenco episodi,
# con i numeri di stagione "veri". SEASONS_ENABLED=false per disattivarlo.
SEASONS_ENABLED=true
# Quante pagine di stagioni affini scaricare per serie.
MAX_SEASON_PAGES=5
# Quanto a lungo resta valida la risoluzione del gruppo di stagioni (ms).
BUNDLE_CACHE_MS=720000

# Cast (attori/doppiatori) da AniList GraphQL: preferiti i doppiatori
# italiani, poi i seiyuu giapponesi, poi i personaggi. false = off.
CAST_ENABLED=true

# Svuota-cache automatico: ogni 30 minuti vengono eliminate le cache locali
# (pagine /play, stream risolti, metadati Kitsu) per liberare spazio ed evitare
# dati stantii; le schede vengono poi ri-arricchite in background. 0 = off.
CACHE_SWEEP_MS=1800000

# Timeout massimo per l'arricchimento di un singolo slug in coda (ms): oltre
# questo tempo la coda passa allo slug successivo.
ENRICH_SLUG_TIMEOUT_MS=60000

# Nella richiesta /meta (scheda anime) il budget massimo per l'arricchimento
# Kitsu on-demand (ms): oltre questo tempo la scheda risponde subito con i soli
# dati AnimeWorld (la trama resta subito leggibile) e l'arricchimento pesante
# prosegue in background con la coda. 0 = bloccante pieno (come prima).
META_ENRICH_TIMEOUT_MS=5000

# Fonti stream AGGIUNTIVE di terze parti (EasyStreams, easystreams.realbestia.com).
# ATTUALMENTE NON USATE: /stream restituisce SOLO lo streaming diretto di
# AnimeWorld (l'utente vuole il solo primo flusso). Il codice di integrazione
# resta nel progetto per una eventuale riattivazione; queste variabili servono
# solo in quel caso. Il plugin Nuvio risponde alle rotte /stream del protocollo
# Stremio; non ha cataloghi (solo-stream), quindi la "ricerca" non esiste lì.
EASYSTREAMS_URL=https://easystreams.realbestia.com/nuvio
EASYSTREAMS_TIMEOUT_MS=15000
EASYSTREAMS_NEG_CACHE_MS=120000

# Livello di log: info | debug
LOG_LEVEL=info
